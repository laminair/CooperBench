# Dockerfile.vastai — CooperBench on Vast.ai (vLLM-served local model)
#
# Built on top of vllm/vllm-openai so we don't pay the 4+ GB vllm pip
# install at build time.  The vllm base image already bundles the right
# CUDA + PyTorch + vllm stack, and ships the same vLLM release we were
# pinning manually.
#
# We add only what the outer container needs on top of vllm:
#   - Docker CLI + NVIDIA Container Toolkit (outer container drives
#     child containers via /var/run/docker.sock)
#   - Node.js 20 + @anthropic-ai/claude-code CLI (used by the
#     `claude_code` agent)
#   - CooperBench (editable install from this build context)
#
# Size tradeoff vs the nvidia/cuda base:
#   * vllm base layers are ~8.5 GB (pre-installed vllm + torch + CUDA
#     libs that the vllm project tests together).  Our added layers
#     (docker, nvidia-ctk, nodejs, claude-code, cooperbench) are ~1.5
#     GB, so the resulting image is ~10 GB compressed — larger than the
#     previous nvidia/cuda-base build (5.94 GB).
#   * On Vast.ai hosts that already have vllm base layers cached
#     (common — many users deploy vllm), only the ~1.5 GB delta
#     downloads.  That's the win we expect in practice.
#   * Build time drops from ~20 min (vllm pip install) to <2 min.
#
# Build & push:
#   docker build -f Dockerfile.vastai -t ghcr.io/laminair/cooperbench-vastai:0.0.23 .
#   docker push   ghcr.io/laminair/cooperbench-vastai:0.0.23

FROM docker.io/vllm/vllm-openai:v0.23.0

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH="/root/.local/bin:${PATH}"

# ── System packages ──────────────────────────────────────────────────
# vllm base ships with curl/git/python/etc. pre-installed; we only add
# what the outer container needs on top: docker-in-docker tooling, the
# nodejs runtime for the claude_code CLI, and any missing TLS bits.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        docker.io \
        nvidia-container-toolkit \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# ── Claude Code CLI (pinned via official curl installer) ────────────
# Pin matches the version CooperBench was tested against.  Bump deliberately;
# the agent code reads the live CLI and is sensitive to schema drift.
ARG CLAUDE_CODE_VERSION=2.1.186
RUN curl -fsSL https://claude.ai/install.sh | bash -s -- "${CLAUDE_CODE_VERSION}" \
 && { \
        echo 'export PATH="/root/.local/bin:${PATH}"'; \
        echo 'export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1'; \
    } > /etc/profile.d/claude.sh

# ── CooperBench (editable from build context) ───────────────────────
# vllm base uses uv-managed Python at /opt/uv/python.  Use uv pip with
# --system so packages land in the same environment vllm is installed
# in.  --break-system-packages is not needed; vllm's image allows
# global installs by default.
#
# Drop the [dev] extra for the runtime image: it pulls pytest/mypy/ruff/
# fakeredis for contributors running tests, and those resolve against
# vllm's dep tree.  Install them in a dev image with --target or a
# separate stage if you need to run the test suite inside the container.
#
# The three openhands-* packages are vendored under
# src/cooperbench/agents/openhands_agent_sdk/.  We install them from
# their local paths first (editable, so conftest-style imports still
# resolve to the vendored source) and then `uv pip install` with
# --no-deps for those three names.  Without the path-based installs
# uv falls back to PyPI, where newer openhands-sdk versions pull in
# stricter lmnr pins that conflict with what vllm has already resolved.
WORKDIR /opt/cooperbench
COPY . /opt/cooperbench
RUN uv pip install --system --no-cache \
        -e ./src/cooperbench/agents/openhands_agent_sdk/openhands-sdk \
        -e ./src/cooperbench/agents/openhands_agent_sdk/openhands-tools \
        -e ./src/cooperbench/agents/openhands_agent_sdk/openhands-workspace \
 && uv pip install --system --no-cache \
        -e . \
        --no-deps \
 && uv pip install --system --no-cache \
        $(python3 -c "import tomllib, sys; d=tomllib.load(open('pyproject.toml','rb'))['project']['dependencies']; print(' '.join(p for p in d if not p.split('>=')[0].split('==')[0].startswith(('openhands-',))))")

# ── Defaults consumed by scripts/serve_vllm.sh + the claude_code agent ─
# Override at container start with `docker run -e VLLM_MODEL=... ...`.
ENV VLLM_PORT=8000 \
    VLLM_HOST=0.0.0.0 \
    VLLM_MAX_MODEL_LEN=65536 \
    VLLM_GPU_MEMORY_UTILIZATION=0.92 \
    VLLM_QUANTIZATION=awq \
    VLLM_TOOL_PARSER=qwen3_coder \
    VLLM_MODEL=cyankiwi/Qwen3.6-27B-AWQ-INT4 \
    VLLM_SERVED_NAME=qwen3.6-27b-awq-int4 \
    HF_HOME=/root/.cache/huggingface \
    COOPERBENCH_DIR=/opt/cooperbench

WORKDIR /workspace
EXPOSE 8000 6379

CMD ["bash"]
