# CooperBench Environment Variables
# Copy this file to .env and fill in your values.

# LLM Provider API Keys (at least one required for Modal / GCP / Harbor runs)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# HuggingFace (optional, for saving results and dataset download)
HF_TOKEN=

# ── Vast.ai / self-hosted vLLM ───────────────────────────────────────
# Used by `claude_code` (forwarded into the task container as
# ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN).
#
# Example: a vLLM server you launched on a Vast.ai box
#   ANTHROPIC_BASE_URL=http://host.docker.internal:8000
#   ANTHROPIC_AUTH_TOKEN=dummy
# (host.docker.internal resolves from inside the agent container to the
# host running vLLM when the Vast.ai template has the docker socket
# mounted; otherwise point at the VM's actual IP.)
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=

# Path to a custom agent YAML (consumed by the agent's --agent-config flag).
# Useful for overriding compaction triggers, step limits, or model kwargs
# without editing the bundled defaults.
COOPERBENCH_AGENT_CONFIG=
